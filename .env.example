# New Relic Configuration
# To enable New Relic monitoring, copy this file to .env and set your actual values

# Your New Relic license key (required for monitoring)
# Get this from: https://one.newrelic.com > Account Settings > API Keys
NEW_RELIC_LICENSE_KEY=your_license_key_here

# The name your application will appear as in New Relic
NEW_RELIC_APP_NAME=Fullstack Checkout Service

# Environment name: development, staging, or production (optional, defaults to development)
NEW_RELIC_ENVIRONMENT=development
